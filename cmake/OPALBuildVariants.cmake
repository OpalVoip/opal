# Adds the "debug" and "both" build targets.
#
# Single-config generators keep this tree as Release (or whatever
# CMAKE_BUILD_TYPE the user set) and configure a second tree at
# ${CMAKE_BINARY_DIR}/debug with CMAKE_BUILD_TYPE=Debug. That Debug
# tree compiles PTRACE in, the same way PTLib's debug target does.
# Multi-config generators build the Debug and Release configurations
# of this tree.

if(OPAL_SECONDARY_BUILD)
  return()
endif()

cmake_host_system_information(RESULT _opal_jobs QUERY NUMBER_OF_LOGICAL_CORES)
if(DEFINED ENV{CMAKE_BUILD_PARALLEL_LEVEL} AND NOT "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}" STREQUAL "")
  set(_opal_jobs "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}")
endif()

get_property(_opal_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)

if(_opal_multi_config)
  add_custom_target(debug
    COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
            --config Debug --parallel "${_opal_jobs}"
    USES_TERMINAL
    VERBATIM
    COMMENT "Building Debug OPAL")
  add_custom_target(both
    COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
            --config Release --parallel "${_opal_jobs}"
    COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
            --config Debug --parallel "${_opal_jobs}"
    USES_TERMINAL
    VERBATIM
    COMMENT "Building Release and Debug OPAL")
  return()
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Debug")
  message(STATUS "OPAL: this tree is Debug; the debug and both targets are not added")
  return()
endif()

set(_opal_debug_dir "${CMAKE_BINARY_DIR}/debug")
set(_opal_debug_cache "${CMAKE_BINARY_DIR}/opal-debug-cache.cmake")

set(_opal_forward_names
  CMAKE_TOOLCHAIN_FILE
  CMAKE_INSTALL_PREFIX
  CMAKE_PREFIX_PATH
  CMAKE_FIND_ROOT_PATH
  CMAKE_SYSROOT
  CMAKE_OSX_ARCHITECTURES
  CMAKE_OSX_DEPLOYMENT_TARGET
  CMAKE_OSX_SYSROOT
  CMAKE_C_COMPILER
  CMAKE_CXX_COMPILER
  CMAKE_OBJCXX_COMPILER
  CMAKE_C_COMPILER_LAUNCHER
  CMAKE_CXX_COMPILER_LAUNCHER
  CMAKE_OBJCXX_COMPILER_LAUNCHER
  CMAKE_C_FLAGS
  CMAKE_CXX_FLAGS
  CMAKE_OBJCXX_FLAGS
  CMAKE_EXE_LINKER_FLAGS
  CMAKE_SHARED_LINKER_FLAGS
  CMAKE_MODULE_LINKER_FLAGS
  CMAKE_MAKE_PROGRAM
  VCPKG_TARGET_TRIPLET
  VCPKG_HOST_TRIPLET
  VCPKG_CHAINLOAD_TOOLCHAIN_FILE
  VCPKG_MANIFEST_FEATURES)

get_cmake_property(_opal_cache_vars CACHE_VARIABLES)
foreach(_name IN LISTS _opal_cache_vars)
  if(_name MATCHES "^OPAL_")
    get_property(_type CACHE ${_name} PROPERTY TYPE)
    if(_type STREQUAL "BOOL" OR _type STREQUAL "STRING" OR _type STREQUAL "PATH" OR _type STREQUAL "FILEPATH")
      list(APPEND _opal_forward_names "${_name}")
    endif()
  endif()
endforeach()

set(_opal_script "# Generated by OPAL. Forwards options into the debug build tree.\n")
string(APPEND _opal_script
  "set(BUILD_SHARED_LIBS \"${BUILD_SHARED_LIBS}\" CACHE BOOL \"\" FORCE)\n")

foreach(_name IN LISTS _opal_forward_names)
  if(NOT DEFINED CACHE{${_name}})
    continue()
  endif()
  get_property(_val CACHE ${_name} PROPERTY VALUE)
  get_property(_type CACHE ${_name} PROPERTY TYPE)
  if(_val STREQUAL "" OR _type STREQUAL "INTERNAL" OR _type STREQUAL "STATIC")
    continue()
  endif()
  string(REPLACE "\\" "\\\\" _val "${_val}")
  string(REPLACE "\"" "\\\"" _val "${_val}")
  string(REPLACE "\$" "\\\$" _val "${_val}")
  string(APPEND _opal_script
    "set(${_name} \"${_val}\" CACHE ${_type} \"\" FORCE)\n")
endforeach()
file(WRITE "${_opal_debug_cache}" "${_opal_script}")

# Prefer a Debug PTLib when that tree already exists, so PTRACE in OPAL
# matches the PTLib it links. Otherwise use the same PTLib as this tree.
set(_opal_debug_ptlib "")
if(DEFINED CACHE{OPAL_PTLIB_DIR} AND NOT "${OPAL_PTLIB_DIR}" STREQUAL "")
  if(EXISTS "${OPAL_PTLIB_DIR}/debug/PTLibConfig.cmake" OR EXISTS "${OPAL_PTLIB_DIR}/debug/PTLibTargets.cmake")
    set(_opal_debug_ptlib "${OPAL_PTLIB_DIR}/debug")
  endif()
endif()

set(_opal_configure
  "${CMAKE_COMMAND}"
  -G "${CMAKE_GENERATOR}"
  -S "${CMAKE_SOURCE_DIR}"
  -B "${_opal_debug_dir}"
  -C "${_opal_debug_cache}"
  -DOPAL_SECONDARY_BUILD=ON
  -DCMAKE_BUILD_TYPE=Debug)
if(_opal_debug_ptlib)
  list(APPEND _opal_configure "-DOPAL_PTLIB_DIR=${_opal_debug_ptlib}")
endif()
if(CMAKE_GENERATOR_PLATFORM)
  list(APPEND _opal_configure -A "${CMAKE_GENERATOR_PLATFORM}")
endif()
if(CMAKE_GENERATOR_TOOLSET)
  list(APPEND _opal_configure -T "${CMAKE_GENERATOR_TOOLSET}")
endif()

add_custom_target(debug
  COMMAND ${_opal_configure}
  COMMAND "${CMAKE_COMMAND}" --build "${_opal_debug_dir}" --parallel "${_opal_jobs}"
  USES_TERMINAL
  VERBATIM
  COMMENT "Configuring and building Debug OPAL in ${_opal_debug_dir}")

# "both" builds the same targets as the default "all" target, plus debug.
# Depending on them here uses this build's job pool. A nested cmake --build of
# this same directory would re-enter the generator.
function(opal_collect_targets dir out_var)
  get_property(_targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(_subdir IN LISTS _subdirs)
    opal_collect_targets("${_subdir}" _sub_targets)
    list(APPEND _targets ${_sub_targets})
  endforeach()
  set(${out_var} "${_targets}" PARENT_SCOPE)
endfunction()

opal_collect_targets("${CMAKE_SOURCE_DIR}" _opal_all_targets)
set(_opal_release_targets "")
foreach(_target IN LISTS _opal_all_targets)
  get_target_property(_excluded "${_target}" EXCLUDE_FROM_ALL)
  if(_excluded)
    continue()
  endif()
  list(APPEND _opal_release_targets "${_target}")
endforeach()

add_custom_target(both
  DEPENDS ${_opal_release_targets} debug
  COMMENT "Building Release and Debug OPAL")

set_property(DIRECTORY APPEND PROPERTY ADDITIONAL_CLEAN_FILES "${_opal_debug_dir}")

message(STATUS "OPAL default target: ${CMAKE_BUILD_TYPE}. Also available: debug, both")
