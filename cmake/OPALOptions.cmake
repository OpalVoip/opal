foreach(pair IN ITEMS
    "SSL;P_SSL"
    "ASN;P_ASN"
    "EXPAT;P_EXPAT"
    "AUDIO;P_AUDIO"
    "VIDEO;P_VIDEO"
    "WAVFILE;P_WAVFILE"
    "DTMF;P_DTMF"
    "IPV6;P_HAS_IPV6"
    "DNS_RESOLVER;P_DNS_RESOLVER"
    "LDAP;P_LDAP"
    "VXML;P_VXML"
    "CONFIG_FILE;P_CONFIG_FILE")
  list(GET pair 0 _name)
  list(GET pair 1 _macro)
  if(OPAL_HAVE_PTLIB_${_name})
    opal_define(OPAL_PTLIB_${_name} 1)
  endif()
endforeach()

