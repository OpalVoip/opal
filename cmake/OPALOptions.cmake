# Ask the compiler which macros ptlib_config.h actually defines. The header
# contains #define lines that only apply on Windows, so a text search is wrong.
# The probe emits a string for each defined name. Preprocessor expansion would
# replace a bare P_SSL with its value, and gcc -dM is not accepted by cl.
function(opal_collect_includes target out_var)
  set(_acc "")
  if(NOT TARGET "${target}")
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  get_property(_seen GLOBAL PROPERTY "OPAL_INCLUDE_SEEN_${target}")
  if(_seen)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  set_property(GLOBAL PROPERTY "OPAL_INCLUDE_SEEN_${target}" TRUE)
  get_target_property(_incs "${target}" INTERFACE_INCLUDE_DIRECTORIES)
  if(_incs)
    foreach(_dir IN LISTS _incs)
      if(NOT _dir MATCHES "^\\$<")
        list(APPEND _acc "${_dir}")
      endif()
    endforeach()
  endif()
  get_target_property(_libs "${target}" INTERFACE_LINK_LIBRARIES)
  if(_libs)
    foreach(_lib IN LISTS _libs)
      if(TARGET "${_lib}")
        opal_collect_includes("${_lib}" _sub)
        list(APPEND _acc ${_sub})
      endif()
    endforeach()
  endif()
  set(${out_var} "${_acc}" PARENT_SCOPE)
endfunction()

set(_ptlib_incs "")
opal_collect_includes(PTLib::ptlib _ptlib_incs)
if(_ptlib_incs)
  list(REMOVE_DUPLICATES _ptlib_incs)
endif()
if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
  set(_inc_flag "/I")
else()
  set(_inc_flag "-I")
endif()
set(_probe_flags "")
set(_found_config FALSE)
foreach(_dir IN LISTS _ptlib_incs)
  list(APPEND _probe_flags "${_inc_flag}${_dir}")
  if(EXISTS "${_dir}/ptlib_config.h")
    set(_found_config TRUE)
  endif()
endforeach()
if(NOT _found_config)
  message(FATAL_ERROR "Found PTLib but could not read ptlib_config.h")
endif()
set(_ptlib_cxx 20)
foreach(_dir IN LISTS _ptlib_incs)
  if(EXISTS "${_dir}/ptlib_config.h")
    file(READ "${_dir}/ptlib_config.h" _ptlib_cfg)
    if(_ptlib_cfg MATCHES "#[ \t]*define[ \t]+P_CXX_STANDARD[ \t]+([0-9]+)")
      set(_ptlib_cxx "${CMAKE_MATCH_1}")
    endif()
    unset(_ptlib_cfg)
    break()
  endif()
endforeach()
if(OPAL_CXX_STANDARD LESS _ptlib_cxx)
  message(FATAL_ERROR
    "OPAL_CXX_STANDARD=${OPAL_CXX_STANDARD} is older than this PTLib (P_CXX_STANDARD=${_ptlib_cxx}). Build OPAL with that standard or a newer one.")
endif()
unset(_ptlib_cxx)

set(_ptlib_probe_names
  P_SSL P_ASN P_EXPAT P_AUDIO P_VIDEO P_WAVFILE P_DTMF P_HAS_IPV6
  P_DNS_RESOLVER P_LDAP P_VXML P_CONFIG_FILE P_HTTP P_CLI P_HTTPSVC
  P_GSTREAMER P_NAT P_STUN P_STUNSRVR P_FFMPEG)
set(_probe_src "#include <ptlib_config.h>\n")
foreach(_name IN LISTS _ptlib_probe_names)
  string(APPEND _probe_src
    "#if defined(${_name})\nOPAL_PTLIB_MACRO \"${_name}\"\n#endif\n")
endforeach()
set(_probe "${CMAKE_BINARY_DIR}/CMakeFiles/opal_ptlib_probe.cxx")
file(WRITE "${_probe}" "${_probe_src}")
if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
  set(_probe_cmd "${CMAKE_CXX_COMPILER}" /nologo /EP /std:c++${CMAKE_CXX_STANDARD} ${_probe_flags} "${_probe}")
else()
  set(_probe_cmd "${CMAKE_CXX_COMPILER}" -E -P ${_probe_flags} -x c++ -std=c++${CMAKE_CXX_STANDARD} "${_probe}")
endif()
execute_process(
  COMMAND ${_probe_cmd}
  OUTPUT_VARIABLE OPAL_PTLIB_MACROS
  ERROR_VARIABLE _probe_err
  RESULT_VARIABLE _probe_rc)
if(NOT _probe_rc EQUAL 0)
  message(FATAL_ERROR "Failed to preprocess ptlib_config.h:\n${_probe_err}")
endif()

function(opal_ptlib_macro name out)
  set(_found FALSE)
  if(OPAL_PTLIB_MACROS MATCHES "(^|\n)OPAL_PTLIB_MACRO[ \t]+\"${name}\"")
    set(_found TRUE)
  endif()
  set(${out} ${_found} PARENT_SCOPE)
endfunction()

function(opal_require_ptlib feature macro)
  opal_ptlib_macro(${macro} _have)
  if(OPAL_${feature} AND NOT _have)
    message(FATAL_ERROR "OPAL_${feature} is ON but PTLib was built without ${macro}")
  endif()
  if(NOT _have)
    set(OPAL_${feature} OFF PARENT_SCOPE)
  endif()
endfunction()

